# Configurações de Ambiente - Tech Courses Platform

# Banco de Dados
# SQLite (desenvolvimento)
DATABASE_URL=sqlite:///./tech_courses.db

# PostgreSQL (produção)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/tech_courses

# Segurança JWT
SECRET_KEY=sua-chave-secreta-muito-segura-aqui-change-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Configuração do LLM
LLM_BACKEND=mock
# Opções: "mock" (desenvolvimento), "ollama" (local), "openai" (API)

# Ollama (se usar LLM local)
OLLAMA_URL=http://localhost:11434
MODEL_NAME=mistral

# OpenAI (se usar API)
# OPENAI_API_KEY=sk-...

# Servidor
HOST=0.0.0.0
PORT=8000

# CORS (em produção, especificar domínios)
CORS_ORIGINS=*
