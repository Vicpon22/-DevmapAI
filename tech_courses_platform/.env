# Configurações de Ambiente - Tech Courses Platform

# Banco de Dados
DATABASE_URL=sqlite:///./tech_courses.db

# Segurança JWT
SECRET_KEY=tech-courses-secret-key-2024-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Configuração do LLM
LLM_BACKEND=mock

# Ollama (se usar LLM local)
OLLAMA_URL=http://localhost:11434
MODEL_NAME=mistral

# Servidor
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=*
